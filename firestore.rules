rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só o documento único usado pelo Fechamento de Caixa pode ser lido/escrito,
    // e só por quem tiver um token de autenticação válido do Firebase — o
    // app faz login anônimo automático (silencioso, sem pedir nada da
    // pessoa) assim que carrega, então isso não muda a experiência de
    // ninguém. O que muda é que um script qualquer, com só o apiKey do
    // projeto (visível no código-fonte, já que este app não tem servidor
    // por trás), não consegue mais ler nem escrever direto no banco sem
    // nunca passar pelo app de verdade.
    //
    // A proteção "de verdade" (quem pode ver o quê, quem pode editar o
    // quê) continua sendo a senha de cada loja/administrador dentro do
    // próprio app — isso aqui é uma camada a mais, não substitui aquela.
    match /fechamento_caixa/{docId} {
      allow read, write: if request.auth != null;
    }

    // Backup diário automático (ver maybeWriteDailyBackup no index.html):
    // qualquer sessão autenticada pode CRIAR um snapshot novo (um por dia,
    // nunca sobrescrevendo o de outro dia) e LER os snapshots existentes,
    // mas ninguém — nem o próprio autor, nem um cliente comprometido com
    // acesso de escrita total ao documento principal — pode alterar ou
    // apagar um backup depois que ele existe. É essa imutabilidade que
    // torna essa coleção útil como plano de recuperação: mesmo que o
    // documento principal seja corrompido ou apagado, os backups já
    // criados continuam intactos.
    match /backups/{backupId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
